      "id": "quality-engineering",
      "repository": "RBraga01/Quality-Engineering-Skills",
      "branch": "master",
      "license": "MIT",
      "include": [
        "skills/problem-solving/8d-problem-solving",
        "skills/problem-solving/dmaic",
        "skills/problem-solving/is-is-not-scoping",
        "skills/problem-solving/5why-root-cause",
        "skills/problem-solving/fishbone-analysis",
        "skills/documentation/8d-report-writing"
      ],
      "licenseFiles": [
        "LICENSE"
      ],
      "patches": [
        {
          "file": "patches/quality-engineering/0001-dmaic-statistics.patch",
          "reason": "DMAIC worked example recalculated (Welch p about 0.023, 95% CI, normal-model tail estimate 15.9% to 9.8%) with a corrected conclusion; decision rules no longer treat significance as proof of cause or non-significance as proof of no effect."
        },
        {
          "file": "patches/quality-engineering/0002-8d-verification-sample.patch",
          "reason": "8D D6 sample size follows n >= log(alpha)/log(1-p) (2% at alpha 0.05 rounds up to 149; a higher rate needs fewer units), and zero recurrence in the sample is a bound on the remaining rate, not proof of permanent elimination."
        },
        {
          "file": "patches/quality-engineering/0003-root-cause-reasoning.patch",
          "reason": "Is/Is-Not no longer eliminates an inspection-gauge hypothesis with the escape it would explain; the 5-Why reversibility test reads cause to effect and drops the never-recur promise; a single-shift fishbone pattern is a hypothesis, not an operator cause."
        }
      ]
    },
