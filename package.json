{
  "name": "pi-workbench",
  "version": "0.1.0",
  "description": "On-demand requirements, game, vision AI, manufacturing, coding and promotional media skills for Pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmfkzj/pi-workbench.git"
  },
  "homepage": "https://github.com/zmfkzj/pi-workbench#readme",
  "bugs": {
    "url": "https://github.com/zmfkzj/pi-workbench/issues"
  },
  "keywords": [
    "pi-package",
    "skills",
    "requirements",
    "game-development",
    "vision-ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "lib",
    "skills",
    "vendor",
    "patches",
    "docs",
    "scripts",
    "tests",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "catalog.json",
    "sources.json",
    "sources.lock.json",
    "vendor-integrity.json"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/runtime.test.mjs tests/dependencies.test.mjs tests/vendor-corrections.test.mjs",
    "test:pi-session": "node tests/pi-session.mjs",
    "test:pi-editor": "node tests/pi-editor.mjs",
    "vendor": "python3 scripts/vendor_sources.py"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./index.js"
    ]
  }
}
